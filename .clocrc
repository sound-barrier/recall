# cloc configuration for `task cloc` and `task cloc-detail`
# (https://github.com/AlDanial/cloc).
#
# cloc does NOT read this file on its own (its default is
# ~/.config/cloc/options.txt), so both tasks pass --config explicitly.
# scripts/cloc-report.sh uses it for the whole-repository table only; its
# production and test counts are built from `go list` and `git ls-files`.

# Count what git tracks. Everything .gitignore already excludes (node_modules,
# dist, coverage, tmp, tools/node_modules, …) stays out with no second list to
# keep in step.
--vcs=git

# Tracked but not written by hand: the Wails build scaffold, the devcontainer
# (mostly JSON), and the hey-api SDK `task gen-types` regenerates into
# frontend/src/client. --fullpath lets the directory regex see the whole path.
--fullpath
--not-match-d=(^|/)(build|\.devcontainer|frontend/src/client)(/|$)

# Lockfiles and release-please's own output.
--not-match-f=(^|/)(go\.sum|package-lock\.json|mise\.lock|CHANGELOG\.md|\.release-please-manifest\.json)$

# Binary assets cloc would otherwise try to read.
--exclude-ext=png,jpg,jpeg,gif,ico,icns,woff,woff2,ttf,otf,pdf,db,sqlite

# Leave out the run's timing, so the same tree always prints the same table.
--hide-rate

# Output format is deliberately not pinned, so `task cloc` prints the compact
# per-language summary; `task cloc-detail` adds --by-file-by-lang.
