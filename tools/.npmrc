# The npm CLIs Taskfile, lefthook and CI run (listed in package.json beside
# this file), installed with `task tools-install`. Same seven-day
# supply-chain cooldown as frontend/.npmrc; see CONTRIBUTING.md → "npm
# supply-chain cooldown" for why and for the CVE override.
min-release-age=7
# A bump names one exact version, so package.json and the lockfile agree on
# what runs without a range to resolve.
save-exact=true
# None of these CLIs needs an install script, and a compromised release's
# payload usually rides in one.
ignore-scripts=true
