{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint 'src/**/*.{css,vue}'",
    "lint:html": "htmlhint --config .htmlhintrc index.html ../docs/api/index.html",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "gen:types": "openapi-typescript ../api/openapi.yaml -o src/api.gen.d.ts",
    "dead:ts": "knip",
    "postinstall": "node ./scripts/seed-go-sentinel.cjs"
  },
  "dependencies": {
    "@wailsio/runtime": "^3.0.0-alpha.97",
    "echarts": "^6.1.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-echarts": "^8.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.60.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.7.0",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-vue": "^10.9.2",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "htmlhint": "^1.9.2",
    "knip": "^6.26.0",
    "monocart-coverage-reports": "^2.12.12",
    "openapi-typescript": "^7.13.0",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "1.11.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "js-yaml": "4.2.0"
  }
}
