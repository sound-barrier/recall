{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint 'src/**/*.{css,vue}'",
    "lint:html": "htmlhint --config .htmlhintrc index.html ../docs/api/index.html",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "gen:types": "openapi-ts",
    "elo:catalog": "node scripts/elo-scenario-catalog.cjs",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "lint:dupes": "jscpd",
    "dead:ts": "knip",
    "postinstall": "node ./scripts/seed-go-sentinel.cjs"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.104.2",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-bold": "3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-hard-break": "3.31.4",
    "@tiptap/extension-heading": "3.31.4",
    "@tiptap/extension-italic": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-strike": "3.31.4",
    "@tiptap/extension-text": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/vue-3": "3.31.4",
    "@wailsio/runtime": "3.0.0-beta.26",
    "echarts": "^6.1.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-echarts": "^8.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.6.5",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.24",
    "@vue/devtools-api": "^8.2.1",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "htmlhint": "^1.9.2",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "monocart-coverage-reports": "^2.13.2",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.12",
    "postcss": "8.5.28",
    "@tiptap/extension-bubble-menu": "3.31.4",
    "@tiptap/extension-floating-menu": "3.31.4",
    "fast-uri": "3.1.8",
    "nanoid": "3.3.19"
  }
}
