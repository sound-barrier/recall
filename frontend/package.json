{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint 'src/**/*.{css,vue}'",
    "lint:html": "htmlhint --config .htmlhintrc index.html ../docs/api/index.html",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "gen:types": "openapi-typescript ../api/openapi.yaml -o src/api.gen.d.ts",
    "elo:catalog": "node scripts/elo-scenario-catalog.cjs",
    "dead:ts": "knip",
    "postinstall": "node ./scripts/seed-go-sentinel.cjs"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0-beta.5",
    "echarts": "^6.1.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-echarts": "^8.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "@vue/devtools-api": "^8.2.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "htmlhint": "^1.9.2",
    "knip": "^6.29.0",
    "monocart-coverage-reports": "^2.12.12",
    "openapi-typescript": "^7.13.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "1.11.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.9",
    "postcss": "8.5.26",
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18"
  }
}
