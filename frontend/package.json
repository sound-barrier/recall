{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint 'src/**/*.{css,vue}'",
    "lint:html": "htmlhint --config .htmlhintrc index.html ../docs/api/index.html",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "gen:types": "openapi-ts",
    "elo:catalog": "node scripts/elo-scenario-catalog.cjs",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "lint:dupes": "jscpd",
    "dead:ts": "knip",
    "postinstall": "node ./scripts/seed-go-sentinel.cjs"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.101.4",
    "@tiptap/core": "3.30.1",
    "@tiptap/extension-bold": "3.30.1",
    "@tiptap/extension-document": "3.30.1",
    "@tiptap/extension-hard-break": "3.30.1",
    "@tiptap/extension-heading": "3.30.1",
    "@tiptap/extension-italic": "3.30.1",
    "@tiptap/extension-list": "3.30.1",
    "@tiptap/extension-paragraph": "3.30.1",
    "@tiptap/extension-strike": "3.30.1",
    "@tiptap/extension-text": "3.30.1",
    "@tiptap/extensions": "3.30.1",
    "@tiptap/pm": "3.30.1",
    "@tiptap/vue-3": "3.30.1",
    "@wailsio/runtime": "3.0.0-beta.10",
    "echarts": "^6.1.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-echarts": "^8.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.6.5",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "@vue/devtools-api": "^8.2.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "htmlhint": "^1.9.2",
    "jscpd": "^5.0.16",
    "knip": "^6.29.0",
    "monocart-coverage-reports": "^2.12.12",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "1.11.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.9",
    "postcss": "8.5.26",
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18"
  }
}
